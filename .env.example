# Public Google Apps Script Web App URL (ends in /exec). Not a secret.
# Leave empty in local dev to use the simulated "demo" submission.
VITE_LEAD_ENDPOINT=

# Production origin, no trailing slash — used for canonical / og:url.
VITE_SITE_URL=https://www.example.com

# true  = show unverified content with "Awaiting confirmation" badges (review/staging builds)
# false = hide everything not marked verified (production)
VITE_SHOW_DRAFTS=true
